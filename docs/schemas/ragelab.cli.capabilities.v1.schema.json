{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ragelab.dev/schemas/ragelab.cli.capabilities.v1.schema.json",
  "title": "RageLab CLI Global Capabilities v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schemaVersion",
    "product",
    "version",
    "build",
    "compiledModules",
    "assetFormats",
    "externalDependencies",
    "commands",
    "canonicalCommands",
    "structuredOutput",
    "legacyAliases",
    "responseEnvelope"
  ],
  "properties": {
    "schema": {
      "const": "ragelab.cli.capabilities"
    },
    "schemaVersion": {
      "const": 1
    },
    "product": {
      "const": "RageLab"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "build": {
      "$ref": "#/$defs/build"
    },
    "compiledModules": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "assetFormats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/assetFormat"
      }
    },
    "externalDependencies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/externalDependency"
      }
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "canonicalCommands": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "structuredOutput": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "legacyAliases": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "responseEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "schemaVersion"
      ],
      "properties": {
        "schema": {
          "const": "ragelab.cli.response"
        },
        "schemaVersion": {
          "const": 1
        }
      }
    }
  },
  "$defs": {
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "revision",
        "dirty",
        "apiCompatibilityVersion",
        "profile",
        "target",
        "features"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "dirty": {
          "type": "boolean"
        },
        "apiCompatibilityVersion": {
          "type": "integer",
          "minimum": 1
        },
        "profile": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "triple",
            "operatingSystem",
            "architecture",
            "environment",
            "families"
          ],
          "properties": {
            "triple": {
              "type": "string",
              "minLength": 1
            },
            "operatingSystem": {
              "type": "string",
              "minLength": 1
            },
            "architecture": {
              "type": "string",
              "minLength": 1
            },
            "environment": {
              "type": [
                "string",
                "null"
              ]
            },
            "families": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "features": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "assetFormat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "extension",
        "semanticParser",
        "support",
        "limitation"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "extension": {
          "type": "string",
          "minLength": 1
        },
        "semanticParser": {
          "type": "boolean"
        },
        "support": {
          "enum": [
            "semantic",
            "containerOnly"
          ]
        },
        "limitation": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "externalDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "requiredGlobally",
        "appliesTo",
        "configuration",
        "description"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "requiredGlobally": {
          "type": "boolean"
        },
        "appliesTo": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "configuration": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
