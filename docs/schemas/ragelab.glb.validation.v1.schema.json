{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ragelab.dev/schemas/ragelab.glb.validation.v1.schema.json",
  "title": "RageLab GLB Export Validation Report v1",
  "description": "Validation of a GLB against the current static Legacy YDR pipeline. semanticReopen describes an in-memory YDR parser reopen only; it does not imply CodeWalker GUI or GTA/FiveM runtime acceptance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schemaVersion",
    "sourceName",
    "sourceSha256",
    "sourceByteLength",
    "strict",
    "valid",
    "structuralValid",
    "exportCompatible",
    "geometryDecoded",
    "imagesDecoded",
    "semanticPreflight",
    "semanticReopen",
    "runtimeRenderable",
    "shaderPreset",
    "counts",
    "diagnostics"
  ],
  "properties": {
    "schema": {
      "const": "ragelab.glb.validation"
    },
    "schemaVersion": {
      "const": 1
    },
    "sourceName": {
      "type": "string",
      "minLength": 1
    },
    "sourceSha256": {
      "$ref": "#/$defs/sha256"
    },
    "sourceByteLength": {
      "type": "integer",
      "minimum": 0
    },
    "strict": {
      "type": "boolean"
    },
    "valid": {
      "type": "boolean"
    },
    "structuralValid": {
      "type": "boolean"
    },
    "exportCompatible": {
      "type": "boolean"
    },
    "geometryDecoded": {
      "type": "boolean"
    },
    "imagesDecoded": {
      "type": "boolean"
    },
    "semanticPreflight": {
      "type": "boolean"
    },
    "semanticReopen": {
      "type": "boolean"
    },
    "runtimeRenderable": {
      "const": false
    },
    "shaderPreset": {
      "type": [
        "string",
        "null"
      ]
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenes",
        "nodes",
        "meshes",
        "primitives",
        "decodedPrimitives",
        "accessors",
        "materials",
        "textures",
        "samplers",
        "images"
      ],
      "properties": {
        "scenes": {
          "type": "integer",
          "minimum": 0
        },
        "nodes": {
          "type": "integer",
          "minimum": 0
        },
        "meshes": {
          "type": "integer",
          "minimum": 0
        },
        "primitives": {
          "type": "integer",
          "minimum": 0
        },
        "decodedPrimitives": {
          "type": "integer",
          "minimum": 0
        },
        "accessors": {
          "type": "integer",
          "minimum": 0
        },
        "materials": {
          "type": "integer",
          "minimum": 0
        },
        "textures": {
          "type": "integer",
          "minimum": 0
        },
        "samplers": {
          "type": "integer",
          "minimum": 0
        },
        "images": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "severity",
          "code",
          "path",
          "message",
          "promotedFrom"
        ],
        "properties": {
          "severity": {
            "enum": [
              "error",
              "unsupported",
              "warning",
              "info"
            ]
          },
          "code": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": [
              "string",
              "null"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "promotedFrom": {
            "enum": [
              "error",
              "unsupported",
              "warning",
              "info",
              null
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
