{
  "name": "@ragelab/web-tools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "wasm:sync": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ../../scripts/build-wasm.ps1 -OutDir apps/web-tools/vendor/wasm",
    "dev": "vite",
    "check": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "budget": "node ../../scripts/check-web-budgets.mjs",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@ragelab/wasm": "file:./vendor/wasm",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@types/three": "^0.186.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.7"
  }
}
