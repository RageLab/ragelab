  "legacyBuildProfiles": [
    {
      "id": "synthetic-legacy-a",
      "description": "Synthetic GTA5.exe/update.rpf/outer-RPF fingerprint profile A; no Rockstar bytes."
    },
    {
      "id": "synthetic-legacy-b",
      "description": "Synthetic profile B with different executable/update/archive metadata; must invalidate profile A index."
    }
  ],
  "optionalInstalledProbes": [
    {
      "id": "legacy-sm23",
      "query": "hei_sm_23_strm_0",
      "expectedKind": "ymap",
      "notes": "Run only against a user-owned installed Legacy build; no bytes are committed."
    }
  ],
  "validationGates": [
    {
      "id": "repository-tests",
      "layer": "repository",
      "status": "required_ci",
      "command": "cargo test --locked --workspace",
      "evidence": "Synthetic fixtures and deterministic mutation corpora only."
    },
    {
      "id": "static-analysis",
      "layer": "repository",
      "status": "required_ci",
      "command": "cargo clippy --locked --workspace --all-targets -- -D warnings"
    },
    {
      "id": "format-and-compile",
      "layer": "repository",
      "status": "required_ci",
      "commands": [
        "cargo fmt --all -- --check",
        "cargo check --locked --workspace"
      ]
    },
    {
      "id": "semantic-round-trip",
      "layer": "semantic",
      "status": "required_ci",
      "evidence": "Writers reopen their own output and compare structural metadata, segments or resource payloads."
    },
    {
      "id": "codewalker-core-parser",
      "layer": "independent-parser",
      "status": "external_optional",
      "lastRecordedEvidence": {
        "at": "2026-10-30",
        "tool": "CodeWalker Core parser",
        "revision": "485d56b",
        "accepted": 5,
        "rejected": 0,
        "scope": "Five generated YDR presets; Drawable, geometry, ShaderGroup, samplers and TextureDictionary inspected.",
        "automation": "manual_external_not_ci"
      },
      "notes": "Historical independent Core parser evidence is recorded above. No redistributable CodeWalker Core CLI adapter is currently wired into CI. GUI acceptance remains a separate manual gate."
    },
    {
      "id": "codewalker-gui",
      "layer": "gui-acceptance",
      "status": "manual_external",
      "lastRecordedEvidence": {
